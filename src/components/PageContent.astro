---
import AboutPage from '../views/AboutPage.astro';
import BlogPage from '../views/BlogPage.astro';
import ProjectsPage from '../views/ProjectsPage.astro';
import type { Lang } from '../lib/i18n';
interface Props {
  lang: Lang;
  page: string;
}
const { lang, page } = Astro.props;
---

{page === 'about' ? (
  <AboutPage lang={lang} />
) : page === 'blog' ? (
  <BlogPage lang={lang} />
) : (
  <ProjectsPage lang={lang} page={page} />
)}
