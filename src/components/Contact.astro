---
import { copy, localized, type Lang } from '../lib/i18n';
import Icon from './Icon.astro';
interface Props {
  lang: Lang;
}
const c = copy[Astro.props.lang];
---

<section class="shell pb-20">
  <div
    data-reveal="scale"
    class="relative isolate overflow-hidden rounded-[2rem] bg-[#121225] px-6 py-16 text-center text-white md:py-20"
  >
    <div class="pointer-events-none absolute -top-24 left-1/4 -z-10 size-80 rounded-full bg-indigo-600/35 blur-3xl"></div>
    <div class="pointer-events-none absolute -right-12 -bottom-44 -z-10 size-96 rounded-full bg-fuchsia-600/25 blur-3xl"></div>
    <Icon name="spark" class="mx-auto mb-5 size-8 text-purple-300" />
    <h2 class="heading">{c.cta}</h2>
    <p class="mx-auto mt-5 max-w-lg text-sm leading-7 text-slate-300">
      {c.ctaDesc}
    </p>
    <a
      href={localized(Astro.props.lang, 'cotizacion')}
      class="pill primary mt-8 mr-3"
    >
      {c.quote}
      <Icon class="size-4" />
    </a>
    <a href="mailto:contacto@marcosgzz.tech" class="pill secondary mt-8">
      {c.email}
      <Icon name="mail" class="size-4" />
    </a>
  </div>
</section>
