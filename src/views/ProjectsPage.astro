---
import { copy, translate, localized, type Lang } from '../lib/i18n';
import Contact from '../components/Contact.astro';
import Icon from '../components/Icon.astro';
import PageHeader from '../components/PageHeader.astro';
interface Props {
  lang: Lang;
  page?: string;
}
const { lang, page = '' } = Astro.props;
const c = copy[lang];
import { personalProjects, workProjects, tdiProjects } from '../data/projects';
import ProjectCard from '../components/ProjectCard.astro';
const titles: Record<string, string> = {
  projects: c.workTitle,
  'personal-projects': translate(lang, 'projects.personalProjects.title'),
  'projects-bbx': translate(lang, 'projects.bbxProjects.title'),
  'projects-tdi': translate(lang, 'projects.cardtitle3'),
};
const descriptions: Record<string, string> = {
  projects: c.workDesc,
  'personal-projects': c.personalDesc,
  'projects-bbx': c.bbxDesc,
  'projects-tdi': c.tdiDesc,
};
const projects =
  page === 'projects-tdi'
    ? tdiProjects
    : page === 'personal-projects'
      ? personalProjects
      : workProjects;
const categories = [
  {
    key: 'cardtitle3',
    path: 'projects-tdi',
    image: 'https://ik.imagekit.io/mmagnodev/Logo%20TDI.webp',
    description: c.tdiDesc,
    count: String(tdiProjects.length).padStart(2, '0'),
  },
  {
    key: 'cardtitle1',
    path: 'personal-projects',
    image: 'https://ik.imagekit.io/mmagnodev/personal_projects_bg.webp',
    description: c.personalDesc,
    count: String(personalProjects.length).padStart(2, '0'),
  },
  {
    key: 'cardtitle2',
    path: 'projects-bbx',
    image: 'https://ik.imagekit.io/mmagnodev/balabox.webp',
    description: c.bbxDesc,
    count: String(workProjects.length).padStart(2, '0'),
  },
];
---

<PageHeader
  title={titles[page]}
  description={descriptions[page]}
  label={c.portfolio}
/>
{page === 'projects' && (
  <section class="shell section">
    <div data-stagger class="grid gap-7 md:grid-cols-3">
      {categories.map((category) => (
        <div data-reveal="fade">
          <a
            href={localized(lang, category.path)}
            class="project-card group block h-full"
          >
            <div class="relative aspect-[4/3] overflow-hidden bg-indigo-100">
              <img
                src={category.image}
                alt=""
                width="600"
                height="450"
                class="h-full w-full object-cover transition duration-500 motion-safe:group-hover:scale-105 motion-safe:group-focus-visible:scale-105"
              />
              <span class="absolute top-4 right-4 rounded-full bg-white/90 px-3 py-1 text-xs font-bold backdrop-blur">
                {category.count}
              </span>
            </div>
            <div class="p-7">
              <h2 class="text-xl font-extrabold">
                {translate(lang, `projects.${category.key}`)}
              </h2>
              <p class="mt-3 text-sm leading-7 text-slate-500">
                {category.description}
              </p>
              <span class="mt-6 inline-flex items-center gap-2 text-sm font-bold text-indigo-600">
                {c.work}
                <Icon class="size-4" />
              </span>
            </div>
          </a>
        </div>
      ))}
    </div>
  </section>
)}
{(page === 'personal-projects' ||
  page === 'projects-bbx' ||
  page === 'projects-tdi') && (
  <section class="shell section">
    <a
      href={localized(lang, 'projects')}
      class="mb-8 inline-block text-sm font-bold text-indigo-600"
    >
      ← {c.back}
    </a>
    <div data-stagger class="grid gap-7 md:grid-cols-2 lg:grid-cols-3">
      {projects.map((project) => (
        <div data-reveal="fade">
          <ProjectCard project={project} lang={lang} />
        </div>
      ))}
      {page === 'personal-projects' &&
        [0, 1, 2].map((_, i) => (
          <div class="glass flex min-h-72 flex-col justify-center p-8">
            <span class="text-sm font-bold text-indigo-300">0{i + 3}</span>
            <Icon name="spark" class="my-6 size-8 text-indigo-500" />
            <h2 class="text-xl font-bold">{c.soon}</h2>
            <p class="mt-3 text-sm leading-7 text-slate-500">
              {c.personalDesc}
            </p>
          </div>
        ))}
    </div>
    {page === 'projects-bbx' && (
      <div class="mt-12 flex flex-col items-start gap-4">
        <a
          href="https://ik.imagekit.io/mmagnodev/Book-portfolio-wordpress-2023.pdf"
          target="_blank"
          rel="noopener noreferrer"
          class="pill secondary"
        >
          {translate(lang, 'projects.bbxProjects.btnDownload')}
          <Icon class="size-4" />
        </a>
        <p class="text-xs text-slate-500">
          {translate(lang, 'projects.bbxProjects.desc')}{' '}
          {translate(lang, 'projects.bbxProjects.desc2')}
        </p>
      </div>
    )}
  </section>
)}

<Contact lang={lang} />
