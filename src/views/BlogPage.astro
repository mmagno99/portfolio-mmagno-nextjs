---
import { copy, translate, localized, type Lang } from '../lib/i18n';
import Contact from '../components/Contact.astro';
import Icon from '../components/Icon.astro';
import PageHeader from '../components/PageHeader.astro';
interface Props {
  lang: Lang;
  page?: string;
}
const { lang } = Astro.props;
const c = copy[lang];
import { getCollection } from 'astro:content';
const posts = (
  await getCollection('blog', ({ data }) => data.lang === lang)
).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<PageHeader
  title={c.journal}
  description={c.journalDesc}
  label={translate(lang, 'navbar.nav4')}
/>

<section class="shell section">
  <p class="mb-8 text-sm text-slate-500">{c.blogNote}</p>
  <div data-stagger class="grid gap-7 md:grid-cols-3">
    {posts.map((post) => (
      <div data-reveal="fade">
        <a
          href={localized(lang, `blog/${post.data.slug}`)}
          class="project-card group block h-full"
        >
          <div class="aspect-[4/3] overflow-hidden bg-indigo-100">
            <img
              src={post.data.image}
              alt=""
              width="600"
              height="450"
              loading="lazy"
              class="h-full w-full object-cover transition duration-500 motion-safe:group-hover:scale-105 motion-safe:group-focus-visible:scale-105"
            />
          </div>
          <div class="p-7">
            <time
              datetime={post.data.date.toISOString()}
              class="text-xs font-semibold text-indigo-600"
            >
              {post.data.date.toLocaleDateString(lang, {
                year: 'numeric',
                month: 'long',
                day: 'numeric',
                timeZone: 'UTC',
              })}
            </time>
            <h2
              lang={lang}
              class="mt-4 text-xl leading-snug font-extrabold tracking-tight"
            >
              {post.data.title}
            </h2>
            <p class="mt-3 text-sm leading-7 text-slate-500">
              {post.data.description}
            </p>
            <span class="mt-7 inline-flex items-center gap-2 text-sm font-bold text-indigo-600">
              {c.read}
              <Icon class="size-4" />
            </span>
          </div>
        </a>
      </div>
    ))}
  </div>
</section>

<Contact lang={lang} />
