---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Página no encontrada" path="404" noindex>
  <section class="shell py-28 text-center">
    <p class="bg-linear-to-r from-indigo-600 to-fuchsia-600 bg-clip-text text-8xl font-extrabold tracking-tighter text-transparent">
      404
    </p>
    <h1 class="heading mt-6">Página no encontrada</h1>
    <p class="mx-auto mt-5 max-w-md text-sm leading-7 text-slate-500">
      La página que estás buscando no existe o ha sido movida.
    </p>
    <a href="/" class="pill primary mt-8">
      Volver al inicio ↗
    </a>
  </section>
</Layout>
