---
import '../styles/global.css';
import { copy, localized, languages, translate, type Lang } from '../lib/i18n';
import Icon from '../components/Icon.astro';
interface Props {
  lang?: Lang;
  title: string;
  description?: string;
  path?: string;
  image?: string;
  article?: boolean;
  noindex?: boolean;
}
const {
  lang = 'es',
  title,
  description = copy[lang].intro,
  path = '',
  image = 'https://ik.imagekit.io/mmagnodev/profile_1.webp',
  article = false,
  noindex = false,
} = Astro.props;
const c = copy[lang];
const canonical = new URL(
  noindex ? '/404.html' : article ? '/' + path : localized(lang, path),
  Astro.site,
);
const nav = [
  ['', 'navbar.nav1'],
  ['projects', 'navbar.nav2'],
  ['about', 'navbar.nav3'],
  ['blog', 'navbar.nav4'],
];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Mmagno</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#101020" />
    <meta name="author" content="Marcos González" />
    <meta
      name="google-site-verification"
      content="HH9xzJYZot6pZPuhQRomr0W2QJZy4qyw0JrYVTzng38"
    />
    <link rel="icon" href="/favicon.ico" />
    <link rel="manifest" href="/manifest.json" />
    <link rel="canonical" href={canonical} />
    {!noindex &&
      !article &&
      languages.map((l) => (
        <link
          rel="alternate"
          hreflang={l}
          href={new URL(localized(l, path), Astro.site)}
        />
      ))}
    {!noindex && (
      <link
        rel="alternate"
        hreflang="x-default"
        href={new URL('/' + path, Astro.site)}
      />
    )}
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:title" content={`${title} · Mmagno`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta
      property="og:locale"
      content={{ es: 'es_MX', en: 'en_US', pt: 'pt_BR' }[lang]}
    />
    <meta property="og:site_name" content="Mmagno" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:rounded-full focus:bg-white focus:p-4"
    >
      {c.skip}
    </a>
    <header class="sticky top-0 z-40 border-b border-white/70 bg-white/80 backdrop-blur-xl">
      <div class="shell flex min-h-20 items-center justify-between gap-4">
        <a
          href={localized(lang)}
          aria-label={`Mmagno — ${translate(lang, 'navbar.nav1')}`}
          class="text-2xl font-extrabold tracking-tighter"
        >
          mmagno<span class="text-indigo-600">.</span>
        </a>
        <nav
          aria-label={c.portfolio}
          class="hidden items-center gap-7 text-sm font-semibold text-slate-500 md:flex"
        >
          {nav.map(([url, key]) => (
            <a
              href={localized(lang, url)}
              aria-current={path === url ? 'page' : undefined}
              class:list={[
                'transition hover:text-indigo-600',
                { 'text-indigo-600': path === url },
              ]}
            >
              {translate(lang, key)}
            </a>
          ))}
        </nav>
        <div class="flex items-center gap-3 sm:gap-5">
          <nav
            aria-label={c.language}
            class="flex rounded-full border border-slate-200 p-1 text-[11px] font-bold"
          >
            {languages.map((l) => (
              <a
                href={
                  noindex
                    ? localized(l)
                    : article
                      ? localized(l, 'blog')
                      : localized(l, path)
                }
                lang={l}
                aria-label={
                  { es: 'Español', en: 'English', pt: 'Português' }[l]
                }
                aria-current={l === lang ? 'true' : undefined}
                class:list={[
                  'rounded-full px-2.5 py-2 transition',
                  l === lang
                    ? 'bg-ink text-white'
                    : 'text-slate-500 hover:bg-indigo-50',
                ]}
              >
                {l.toUpperCase()}
              </a>
            ))}
          </nav>
          <a
            href="mailto:mmagno.dev@gmail.com"
            class="pill primary hidden lg:inline-flex"
          >
            {c.contact}
            <Icon class="size-4" />
          </a>
          <button
            id="menu-toggle"
            class="hidden rounded-full border border-slate-200 p-2.5"
            aria-controls="mobile-menu"
            aria-expanded="false"
            aria-label={c.menu}
            data-open-label={c.menu}
            data-close-label={c.close}
          >
            <svg
              class="size-5"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <path d="M4 7h16M4 12h16M4 17h16" />
            </svg>
          </button>
        </div>
      </div>
      <nav
        id="mobile-menu"
        aria-label={c.menu}
        class="shell flex flex-wrap gap-5 pb-5 text-sm font-semibold md:hidden"
      >
        {nav.map(([url, key]) => (
          <a
            class="py-2 text-slate-600 hover:text-indigo-600"
            href={localized(lang, url)}
            aria-current={path === url ? 'page' : undefined}
          >
            {translate(lang, key)}
          </a>
        ))}
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="border-t border-slate-200/70 bg-white">
      <div class="shell flex flex-col justify-between gap-8 py-12 sm:flex-row sm:items-center">
        <div>
          <a
            href={localized(lang)}
            class="text-2xl font-extrabold tracking-tighter"
          >
            mmagno<span class="text-indigo-600">.</span>
          </a>
          <p class="mt-3 text-xs text-slate-500">
            © {new Date().getFullYear()} Marcos González.{' '}
            {translate(lang, 'footer.copy')}.
          </p>
        </div>
        <div class="flex flex-wrap gap-5 text-sm font-semibold text-slate-600">
          <a
            href="https://github.com/mmagno99"
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-indigo-600"
          >
            GitHub ↗
          </a>
          <a
            href="https://www.linkedin.com/in/mmagno99/"
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-indigo-600"
          >
            LinkedIn ↗
          </a>
          <a
            href="https://www.instagram.com/mmagno99/"
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-indigo-600"
          >
            Instagram ↗
          </a>
        </div>
      </div>
    </footer>
    <button
      id="back-top"
      class="fixed right-5 bottom-5 z-30 hidden rounded-full border border-white bg-indigo-600 p-3 text-white shadow-lg hover:bg-indigo-700"
      aria-label={c.top}
    >
      <Icon name="up" />
    </button>
    <script>
      const toggle = document.querySelector<HTMLButtonElement>('#menu-toggle');
      const menu = document.querySelector<HTMLElement>('#mobile-menu');
      if (toggle && menu) {
        toggle.classList.remove('hidden');
        toggle.classList.add('md:hidden');
        menu.hidden = true;
        const close = () => {
          menu.hidden = true;
          toggle.setAttribute('aria-expanded', 'false');
          toggle.setAttribute('aria-label', toggle.dataset.openLabel!);
        };
        toggle.addEventListener('click', () => {
          const open = toggle.getAttribute('aria-expanded') !== 'true';
          menu.hidden = !open;
          toggle.setAttribute('aria-expanded', String(open));
          toggle.setAttribute(
            'aria-label',
            open ? toggle.dataset.closeLabel! : toggle.dataset.openLabel!,
          );
        });
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && !menu.hidden) {
            close();
            toggle.focus();
          }
        });
        matchMedia('(min-width: 768px)').addEventListener('change', close);
      }
      const topButton = document.querySelector<HTMLButtonElement>('#back-top');
      const update = () =>
        topButton?.classList.toggle('hidden', window.scrollY < 500);
      window.addEventListener('scroll', update, { passive: true });
      update();
      topButton?.addEventListener('click', () =>
        window.scrollTo({
          top: 0,
          behavior: matchMedia('(prefers-reduced-motion: reduce)').matches
            ? 'instant'
            : 'smooth',
        }),
      );
    </script>
  </body>
</html>
